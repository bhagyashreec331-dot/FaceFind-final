# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key
JWT_SECRET=change-this-jwt-secret
JWT_EXP_HOURS=24

# --- Database ---
# "sqlite" (default): zero setup, writes to backend/facefind.db
# "mysql": set this to mysql and fill in the DB_* values below
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=facefind
DB_USER=root
DB_PASSWORD=

# --- Storage ---
# "local" (default): zero setup, saves to backend/uploads/, served at /media/...
# "r2": set this to r2 and fill in the R2_* values below
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:5000

# Cloudflare R2 (only used when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=facefind-photos
R2_ENDPOINT_URL=

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"). Add GOOGLE_REDIRECT_URI below as
# an authorized redirect URI in that console. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Email (password reset) ---
# Leave SMTP_HOST blank in development — reset links are logged to the
# backend console instead of emailed. Example values for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<a 16-character Gmail App Password, not your real password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Face matching (InsightFace — only active if installed, see requirements-full.txt)
# Cosine-similarity cutoff for a match: ~0.35 lenient, 0.40 balanced, 0.50 strict
FACE_SIMILARITY_THRESHOLD=0.40
# buffalo_l = most accurate (~280 MB download), buffalo_s = smaller/faster
FACE_MODEL=buffalo_l
# Raise to 1024 to catch smaller faces in large group photos (slower)
FACE_DET_SIZE=640

# Rate limit storage — "memory://" is fine for local/single-process use.
# For production with multiple workers, use Redis: "redis://localhost:6379"
RATELIMIT_STORAGE_URI=memory://

# CORS — must match the URL your frontend runs on
FRONTEND_ORIGIN=http://localhost:5173
